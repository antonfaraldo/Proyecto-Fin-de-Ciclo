<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="580.0" prefWidth="850.0" style="-fx-background-color: #f4f7f6;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dam.proyectofinal.afm.controller.AdminController">
    <children>
        <VBox fx:id="panePrincipal" alignment="TOP_CENTER" spacing="20.0">
            <children>
                <HBox alignment="CENTER_LEFT" prefHeight="80.0" style="-fx-background-color: #2c3e50;">
                    <children>
                        <Label text="Panel de Control: Administrador" textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="24.0" />
                            </font>
                            <HBox.margin>
                                <Insets left="30.0" />
                            </HBox.margin>
                        </Label>
                    </children>
                </HBox>

                <VBox spacing="15.0" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets bottom="20.0" left="30.0" right="30.0" top="10.0" />
                    </padding>
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="20.0">
                            <children>
                                <VBox spacing="5.0">
                                    <children>
                                        <Label text="Gestión de Usuarios Registrados" textFill="#7f8c8d">
                                            <font>
                                                <Font size="16.0" />
                                            </font>
                                        </Label>
                                        <Label fx:id="lblTotalUsuarios" text="Usuarios totales: 0" textFill="#2c3e50">
                                            <font>
                                                <Font name="System Bold" size="13.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </VBox>
                                <HBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
                                    <children>
                                        <TextField fx:id="txtFiltro" prefHeight="30.0" prefWidth="250.0" promptText="🔍 Buscar por nickname..." style="-fx-background-radius: 15; -fx-border-color: #bdc3c7; -fx-border-radius: 15; -fx-padding: 0 15 0 15;" />
                                    </children>
                                </HBox>
                            </children>
                        </HBox>

                        <TableView fx:id="tablaUsuarios" prefHeight="320.0" style="-fx-background-radius: 5; -fx-border-radius: 5;">
                            <columns>
                                <TableColumn fx:id="colNickname" prefWidth="120.0" text="Nickname" />
                                <TableColumn fx:id="colEmail" prefWidth="200.0" text="Correo Electrónico" />
                                <TableColumn fx:id="colFecha" prefWidth="150.0" text="Fecha Registro" />
                                <TableColumn fx:id="colUltimoAcceso" prefWidth="150.0" text="Último Acceso" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>

                        <HBox alignment="CENTER_RIGHT" spacing="15.0">
                            <children>
                                <Button fx:id="btnVolver" mnemonicParsing="false" onAction="#handleVolver" prefHeight="35.0" prefWidth="140.0" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Volver al Menú" />
                                <Button fx:id="btnVerStats" mnemonicParsing="false" onAction="#handleVerEstadisticasUsuario" prefHeight="35.0" prefWidth="140.0" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Ver Estadísticas" />
                                <Button fx:id="btnCambiarRol" mnemonicParsing="false" onAction="#handleCambiarRol" prefHeight="35.0" prefWidth="140.0" style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Cambiar Rol" />
                                <Button fx:id="btnEliminar" mnemonicParsing="false" onAction="#handleEliminar" prefHeight="35.0" prefWidth="140.0" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Eliminar Usuario" />
                            </children>
                            <VBox.margin>
                                <Insets top="5.0" />
                            </VBox.margin>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>

        <VBox fx:id="paneConfirmacion" alignment="CENTER" style="-fx-background-color: rgba(44, 62, 80, 0.85);" visible="false">
            <children>
                <VBox alignment="CENTER" maxWidth="450.0" spacing="20.0" style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 15, 0, 0, 0); -fx-border-color: #3498db; -fx-border-width: 2; -fx-border-radius: 15;">
                    <children>
                        <Label fx:id="lblConfirmarTitulo" text="❓ CONFIRMAR ACCIÓN" textFill="#2980b9">
                            <font>
                                <Font name="System Bold" size="20.0" />
                            </font>
                        </Label>
                        <Label fx:id="lblConfirmarMensaje" text="¿Estás seguro de que deseas continuar?" textAlignment="CENTER" textFill="#2c3e50" wrapText="true">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Label>
                        <HBox alignment="CENTER" spacing="20.0">
                            <children>
                                <Button mnemonicParsing="false" onAction="#handleCancelarConfirmacion" prefHeight="38.0" prefWidth="120.0" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 5;" text="CANCELAR" />
                                <Button fx:id="btnAceptarConfirmacion" mnemonicParsing="false" prefHeight="38.0" prefWidth="120.0" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 5;" text="ACEPTAR" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>

        <VBox fx:id="paneAviso" alignment="CENTER" style="-fx-background-color: rgba(0, 0, 0, 0.7);" visible="false">
            <children>
                <VBox alignment="CENTER" maxWidth="420.0" spacing="20.0" style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.4), 15, 0, 0, 0); -fx-border-color: #e67e22; -fx-border-width: 2; -fx-border-radius: 15;">
                    <children>
                        <Label fx:id="lblAvisoTitulo" text="⚠️ ATENCIÓN" textFill="#e67e22">
                            <font>
                                <Font name="System Bold" size="20.0" />
                            </font>
                        </Label>
                        <Label fx:id="lblAvisoMensaje" text="Mensaje informativo o de error del sistema." textAlignment="CENTER" textFill="#2c3e50" wrapText="true">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Label>
                        <Button mnemonicParsing="false" onAction="#handleCerrarAviso" prefHeight="38.0" prefWidth="140.0" style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 5;" text="ENTENDIDO" />
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</StackPane>